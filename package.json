{
  "name": "anime-production-committee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace @anime/web",
    "build": "npm run build:wasm && npm run build:web",
    "build:web": "npm run build --workspace @anime/web",
    "build:wasm": "node scripts/build-core.mjs wasm",
    "build:native": "node scripts/build-core.mjs native",
    "preview": "npm run preview --workspace @anime/web",
    "typecheck": "npm run typecheck --workspace @anime/web",
    "test": "npm run test:unit && npm run test:wasm && npm run test:native",
    "test:unit": "npm run test --workspace @anime/web",
    "test:wasm": "npm run build:wasm && node --test scripts/wasm.test.mjs",
    "test:native": "node scripts/build-core.mjs test",
    "test:browser": "npm run build && node --test scripts/browser.test.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate:events": "node scripts/validate-event-catalog.mjs && node scripts/validate-event-fixtures.mjs",
    "validate:blueprint": "node scripts/validate-blueprint.mjs docs/blueprints/tv_standard.blueprint.json",
    "validate:handover": "node scripts/check-handover-cases.mjs docs/fixtures/handover_cases.json",
    "build:v4": "node scripts/build-event-catalog.mjs && node scripts/build-blueprint-catalog.mjs && node scripts/build-v4.mjs",
    "test:v4": "node scripts/build-event-catalog.mjs && node scripts/build-blueprint-catalog.mjs && node scripts/build-v4.mjs && node --test scripts/v4.test.mjs",
    "build:events": "node scripts/build-event-catalog.mjs",
    "validate:content": "node scripts/validate-event-content.mjs",
    "build:blueprints": "node scripts/build-blueprint-catalog.mjs",
    "audit:v4": "node scripts/audit-v4-contract.mjs",
    "check:docs": "python scripts/check_docs.py",
    "validate:market": "node scripts/check-market-cases.mjs docs/fixtures/market_cases.json",
    "test:market": "node --test scripts/lib/coordinate-random.test.mjs scripts/market.test.mjs",
    "validate:recruit": "node scripts/check-recruit-cases.mjs docs/fixtures/recruit_cases.json",
    "validate:opportunities": "node scripts/validate-opportunity-catalog.mjs",
    "test:recruit": "node --test scripts/recruit.test.mjs",
    "test:suppliers": "node --test scripts/supplier.test.mjs",
    "test:opportunities": "node --test scripts/opportunity.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.1"
  }
}
